// nextflow.config

// ====================================================================================
//                            PIPELINE PARAMETERS
// ====================================================================================
// 


params {
    // =========================== Modification Area [Yale-Bouchet] =================================
    // Don't need to change below settings if you're using Yale-Bouchet

    // 1. Replace this with your conda env
    conda_base_path = '/apps/software/2022b/software/miniconda/24.11.3' 
    conda_env_path = '/home/lt692/project_pi_njl27/shared/mt_calling_inputs/required_software/hail-conda'

    hail_python  = "${params.conda_env_path}/bin/python"
    hail_bin_dir = "${params.conda_env_path}/bin"

    // 1. Root directory for other required software and scripts
    software_base_dir = '/home/lt692/project_pi_njl27/shared/mt_calling_inputs/required_software'
    haplocheckCLI      = "${params.software_base_dir}/haplocheckCLI-master/haplocheckCLI.jar"
    cromwell_jar       = "${params.software_base_dir}/cromwell-90.jar"
    mosdepth           = "${params.software_base_dir}/mosdepth"
    
    // 2. Root directory for reference genomes, databases, and other required input files
    required_base_dir      = '/home/lt692/project_pi_njl27/shared/mt_calling_inputs'

    // 3. Set key parameters 
    vaf_filter_threshold = 0.01   // Set the VAF filter threshold
    min_DP = 100

    // Set the threhold for sample-level filter
    min_mt_cov = 100
    min_mtcn   = 50
    max_mtcn   = 1000
    max_contam = 0.02

    // ================================================================================

    // The launch_pipeline.sh script will provide a path if PIPELINE_MODE is set to "disease".
    pipeline_mode = null
    disease_meta_file = null
    post_filtering = false
    do_post_filter = false

     // These will be passed dynamically from launch_pipeline.sh
    input              = null
    outdir             = null

    // This will generate a summary file for pipeline
    summary_log = "${params.outdir}/pipeline_summary_log.txt"

    // Define default paths consistent with the repo structure
    wdl_script   = "${baseDir}/MitochondriaPipeline_multisample.wdl"
    hail_script  = "${baseDir}/hail"
    picard = "/home/lt692/project_pi_njl27/shared/mt_calling_inputs/required_software/picard.jar"   
    gatk   = "/home/lt692/project_pi_njl27/shared/mt_calling_inputs/required_software/gatk-4.6.2.0/gatk-package-4.6.2.0-local.jar"

    // Interval list used for calculating nuclear coverage 
    wgs_intervals = "${params.required_base_dir}/required_files/autosome_XY.interval_list"

    // -------------------- Cromwell execution -------------------
    // Nextflow submits RUN_WDL_VARIANT_CALLING to Slurm.
    // Cromwell itself uses the Local backend (see cromwell.conf), so WDL tasks
    // run inside the enclosing Slurm allocation and do not submit nested jobs.
    cromwell_backend = 'Local'

    // WDL default runtime attributes only; these no longer control Slurm
    // submissions when Cromwell uses the Local backend.
    cromwell_options = [
    queue: '',
    runtime_minutes: 1440,
    cpus: 1,
    memory: 5120
    ]

}

report {
    enabled = true
    overwrite = true
}

// ====================================================================================
//                       WDL and Hail INPUT PARAMETERS
// ====================================================================================

// --- Static inputs for the WDL workflow ---
// All paths required by your WDL script, except for the sample list, should be defined here.
// Please replace the placeholder paths with the actual paths on your system.
params.wdl_inputs = [

    vaf_filter_threshold: params.vaf_filter_threshold,

    // Software paths
    picard: params.picard,
    gatk:   params.gatk,
    haplocheckCLI:  params.haplocheckCLI,   // Note: This one is still manual

    compress_output_vcf: true,

    // Reference genome paths
    ref_fasta:       "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.fasta",
    ref_dict:        "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.dict",
    ref_fasta_index: "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.fasta.fai",
    mt_dict:         "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.dict",
    mt_fasta:        "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta",
    mt_fasta_index:  "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta.fai",
    mt_amb:          "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta.amb",
    mt_ann:          "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta.ann",
    mt_bwt:          "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta.bwt",
    mt_pac:          "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta.pac",
    mt_sa:           "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.fasta.sa",
    mt_shifted_dict: "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.dict",
    mt_shifted_fasta: "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta",
    mt_shifted_fasta_index: "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta.fai",
    mt_shifted_amb:   "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta.amb",
    mt_shifted_ann:  "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta.ann",
    mt_shifted_bwt:  "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta.bwt",
    mt_shifted_pac:  "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta.pac",
    mt_shifted_sa:   "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta.sa",

    // Other required files
    shift_back_chain: "${params.required_base_dir}/required_files/ShiftBack.chain",
    blacklisted_sites: "${params.required_base_dir}/required_files/blacklist_sites.hg38.chrM.bed",
    blacklisted_sites_index: "${params.required_base_dir}/required_files/blacklist_sites.hg38.chrM.bed.idx",
    non_control_region_interval_list: "${params.required_base_dir}/required_files/non_control_region.interval_list",
    control_region_shifted_reference_interval_list: "${params.required_base_dir}/required_files/control_region_shifted.interval_list"
]

params.hail_pipeline_config = [

        vaf_filter_threshold: params.vaf_filter_threshold,
        min_DP: params.min_DP,
        pipeline_mode: params.pipeline_mode,

        // --- Input directories (will be created by the Nextflow process) ---
        // These are relative to the process work directory
        raw_vcf_dir: "wdl_outputs/vcfs",
        haplocheck_dir: "wdl_outputs/contamination",
        wgs_metrics_dir: "wdl_outputs/wgs_metrics",
        mt_coverage_dir: "wdl_outputs/coverage",
        
        // --- VEP cache directory ---
        vep_cache_dir: "${params.required_base_dir}/annotation_databases",
        reference_genome_path: "${params.required_base_dir}/required_files/Homo_sapiens_assembly38.fasta",

        // --- Output directories (will be created by the Nextflow process) ---
        vep_vcf_dir: "annotation/vep_vcf/",
        metadata_dir: "annotation/metadata/",
        fullhaplogroups: "annotation/metadata/haplogroup_full.txt",
        contamination: "annotation/metadata/contamination.txt",
        final_output_dir: "annotation/final_outputs/",

        // --- Input metadata files (please update these paths) ---
        disease_meta_file: params.disease_meta_file,
        post_filtering: params.post_filtering,
        
        // --- Annotation Database Paths (please update these paths) ---
        gnomadcache: "${params.required_base_dir}/annotation_databases/gnomad.genomes.v3.1.sites.chrM.reduced_annotations.tsv",
        clinvarcache: "${params.required_base_dir}/annotation_databases/clinvar_chrMT_01212026_SNVs_and_indels.txt",
        mitomap_polycache: "${params.required_base_dir}/annotation_databases/MITOMAP_polymorphisms_01192026.txt",
        mitomap_diseasecache: "${params.required_base_dir}/annotation_databases/MITOMAP_disease_01192026.txt",
        helixcache: "${params.required_base_dir}/annotation_databases/HelixMTdb_20200327.tsv",
        haplogroup_varcache: "${params.required_base_dir}/annotation_databases/rCRS-centered_vars_with_haplo_final_update.txt",
        mitimpactcache: "${params.required_base_dir}/annotation_databases/MitImpact_db_3.1.3.txt",
        mitotipcache: "${params.required_base_dir}/annotation_databases/mitotip_scores.txt",
        hmtvarcache: "${params.required_base_dir}/annotation_databases/hmtvar_annotations.txt",

        // --- New annotation database paths ---
        napogeecache: "${params.required_base_dir}/annotation_databases/nAPOGEE_v1.0.0.txt",
        tapogeecache: "${params.required_base_dir}/annotation_databases/t-APOGEE_2024.0.1.txt",
        mlc_snv_cache: "${params.required_base_dir}/annotation_databases/MLC_score_SNP.txt",
        mlc_indel_cache: "${params.required_base_dir}/annotation_databases/MLC_score_Indel.txt",
        regional_constraint_cache: "${params.required_base_dir}/annotation_databases/mito_regional_constraint_annotation.txt"
    ]
// ====================================================================================
//                            EXECUTION PROFILES
// ====================================================================================

profiles {

  cluster {

    // ----- Global process defaults for this profile (apply to all tasks) -----
    process {
      executor = 'slurm'             // run every task on Slurm

    // ------------------------- GROUP 1: alignment/CRAM -----------------------
    withLabel: alignment_related {
      cpus   = 16
      memory = '18.GB'
      time   = '12h'
      // Load only what these steps need
      beforeScript = """
        module purge
        module load BWA/0.7.18-GCCcore-13.3.0
        module load SAMtools/1.21-GCC-13.3.0
        echo "[NF] bwa:      \$(which bwa)"
        echo "[NF] samtools: \$(which samtools)"
      """
    }

    // ------------------- GROUP 2: tiny helpers / JSON/TSV gen ----------------
    withLabel: generation_related {
      cpus   = 1
      memory = '1.GB'
      time   = '1h'
      beforeScript = """
        module purge
        module load Python/3.12.3-GCCcore-13.3.0
        echo "[NF] python: \$(which python)"
      """
    }

    // Normalize malformed CRAI unmapped-slice records before the existing
    // GENERATE_CRAM_TSV script resolves CRAM/CRAI paths. Some 1000G CRAIs
    // contain reference_id=-1,start=0,span=150; newer htsjdk/GATK rejects them.
    // Only the task-local staged CRAI is replaced; the source CRAI is untouched.
    withName: GENERATE_CRAM_TSV {
      beforeScript = '''
        set -euo pipefail

        has_bad_crai() {
          local f="$1"
          if gzip -t "$f" >/dev/null 2>&1; then
            gzip -dc "$f" | awk '$1 == -1 && ($2 != 0 || $3 != 0) {found=1} END {exit(found ? 0 : 1)}'
          else
            awk '$1 == -1 && ($2 != 0 || $3 != 0) {found=1} END {exit(found ? 0 : 1)}' "$f"
          fi
        }

        normalize_crai() {
          local idx="$1"
          local src tmp
          src="$(readlink -f "$idx" 2>/dev/null || printf '%s\n' "$idx")"

          if ! has_bad_crai "$src"; then
            echo "[CRAI] $(basename "$idx"): no normalization needed"
            return 0
          fi

          echo "[CRAI] $(basename "$idx"): malformed unmapped-slice entries detected; normalizing task-local copy"
          tmp="${idx}.normalized.tmp"

          if gzip -t "$src" >/dev/null 2>&1; then
            gzip -dc "$src" | awk 'BEGIN{OFS="\t"} {if ($1 == -1) {$2=0; $3=0} print}' | gzip -c > "$tmp"
          else
            awk 'BEGIN{OFS="\t"} {if ($1 == -1) {$2=0; $3=0} print}' "$src" > "$tmp"
          fi

          rm -f "$idx"
          mv "$tmp" "$idx"

          if has_bad_crai "$idx"; then
            echo "[ERROR] CRAI normalization failed for $idx" >&2
            exit 1
          fi
          echo "[CRAI] $(basename "$idx"): normalization complete"
        }

        shopt -s nullglob
        for idx in *.crai; do
          normalize_crai "$idx"
        done
      '''
    }

    // ------------- GROUP 3: GATK/WDL running ----------
    withLabel: wdl_related {
      // Cromwell Local and all WDL calls execute inside this Slurm allocation.
      cpus   = 8
      memory = '32.GB'
      time   = '24h'
      beforeScript = """
        module purge
        module load BWA/0.7.18-GCCcore-13.3.0
        module load Java/17.0.4
        module load Python/3.12.3-GCCcore-13.3.0
        module load R/4.4.2
        echo "[NF] bwa:      \$(which bwa)"
        echo "[NF] java: \$(which java)"; java -version
      """
    }
    withName: RUN_WDL_VARIANT_CALLING {
      cpus = 8
      memory = '32.GB'
      time = '24h'
      maxForks = 3
    }

    // ------------- GROUP 4: mtCN + sample filter ----------
    withLabel: mtCN_related {
      cpus   = 4
      memory = '8.GB'
      time   = '12h'
      beforeScript = """
        module purge
        source ${params.conda_base_path}/etc/profile.d/conda.sh
        conda deactivate 2>/dev/null || true
        conda activate ${params.conda_env_path}
        echo "[NF] java: \$(which java)"; java -version
      """
    }

    // ------------------------- GROUP 5: VEP annotation -----------------------
    withLabel: vep_related {
      cpus   = 8
      memory = '32.GB'
      time   = '12h'
      beforeScript = """
        module purge
        module load VEP/113.3-GCC-13.3.0
        source ${params.conda_base_path}/etc/profile.d/conda.sh
        conda deactivate 2>/dev/null || true
        conda activate ${params.conda_env_path}
        echo "[NF] vep: \$(which vep)"
      """
    }

    // ------------------------- GROUP 6: hail -----------------------
    withLabel: hail_related {
      cpus   = 8
      memory = '32.GB'
      time   = '12h'
      beforeScript = """
        module purge
        source ${params.conda_base_path}/etc/profile.d/conda.sh
        conda deactivate 2>/dev/null || true
        conda activate ${params.conda_env_path}
        export PATH=${params.hail_bin_dir}:$PATH
        export PYSPARK_PYTHON=${params.hail_python}
      """
    }
    }
  }
}

// ====================================================================================
//                       EXECUTOR & PROCESS CONFIGURATION
// ====================================================================================

// Only Nextflow submits Slurm jobs. 90/h leaves headroom under a 200 jobs/h user limit
// when up to two batch workers are active concurrently.
executor {
    name = 'slurm'
    queueSize = 20
    submitRateLimit = '90/h'
}
